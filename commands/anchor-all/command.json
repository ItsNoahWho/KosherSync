{
  "name": "anchor-all",
  "description": "Anchor every unanchored part under a path",
  "category": "Build",
  "args": {
    "path": { "type": "string", "default": "Workspace" },
    "dryRun": { "type": "boolean", "default": false }
  },
  "examples": [
    "ksync anchor-all",
    "ksync anchor-all --path Workspace/Level1 --dryRun true"
  ]
}
